2996. Smallest Missing Integer Greater Than Sequential Prefix Sum
class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int n= nums.size();
        // int first=nums[0];
        int maxi=nums[0];
        int sum=nums[0];
        for(int i=1; i<n;i++){
            if(nums[i]==nums[i-1]+1){
                sum+=nums[i];
            }else {
               break;
            }
            maxi=max(sum,maxi);
        }
        
        // unordered_map<int,int>
        while(true){
            bool found=false;
            for(int i=0; i<n;i++){
            if(maxi==nums[i]){
               found=true;
               break;
            }
            } 
            if(!found)return maxi;
           maxi++;   
        }
        return maxi;
    }
};
