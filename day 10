3310. Remove Methods From Project
class Solution {
public:
    void dfs(int n, int i, unordered_map<int,vector<int>>&adj,vector<int>&vis){
        vis[i]=1;

        for(auto it:adj[i]){
            if(!vis[it]){
            dfs(n,it,adj,vis);
            }
        }
    }
    vector<int> remainingMethods(int n, int k, vector<vector<int>>& invocations) {
        unordered_map<int,vector<int>>adj;
        for(auto &it:invocations){
            adj[it[0]].push_back(it[1]);
        }

        vector<int>vis(n,0);

        dfs(n,k,adj,vis);

        for (auto &edge : invocations) {
            int u = edge[0];
            int v = edge[1];

            if (!vis[u] && vis[v]) {
                vector<int> ans;
                for (int i = 0; i < n; i++)
                    ans.push_back(i);
                return ans;
            }
        }
        
        vector<int>ans;
        for(int i=0; i<n;i++){
            if(vis[i]==0){
            ans.push_back(i);
            }
        }
        return ans;
    }
};
