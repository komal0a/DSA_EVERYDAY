2958. Length of Longest Subarray With at Most K Frequency
class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        int l=0; int r=0;
        int maxi=0;
        // int len=0;
        unordered_map<int,int>mp;
        while(r<nums.size()){
            mp[nums[r]]++;
            while(l<=r && mp[nums[r]]>k){
                mp[nums[l]]--;
                l++;
            }
            maxi=max(maxi,r-l+1);
            r++;
        }
        return maxi;
    }
};
