3702. Longest Subsequence With Non-Zero Bitwise XOR
class Solution {
public:
    int longestSubsequence(vector<int>& nums) {

        int ans = 0;
        bool hasNonZero = false;

        for (int i = 0; i < nums.size(); i++) {
            ans ^= nums[i];

            if (nums[i] != 0)
                hasNonZero = true;
        }

        if (ans != 0)
            return nums.size();

        if (hasNonZero)
            return nums.size() - 1;

        return 0;
    }
};
