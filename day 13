3302. Find the Lexicographically Smallest Valid Sequence

#include <vector>
#include <string>

class Solution {
public:
    std::vector<int> validSequence(std::string word1, std::string word2) {
        int n1 = word1.length();
        int n2 = word2.length();
        
        std::vector<int> ans(n2);
        // last[j] stores the last occurrence index of word2[j] in word1
        std::vector<int> last(n2, -1);
        
        int i = n1 - 1;
        int j = n2 - 1;
        while (i >= 0 && j >= 0) {
            if (word1[i] == word2[j]) {
                last[j] = i;
                j--;
            }
            i--;
        }
        
        bool canSkip = true;
        j = 0;
        
        for (i = 0; i < n1; ++i) {
            if (j == n2) break;
            
            if (word1[i] == word2[j]) {
                ans[j++] = i;
            } else if (canSkip && (j == n2 - 1 || i < last[j + 1])) {
                // Use our single mismatch/skip allowance
                canSkip = false;
                ans[j++] = i;
            }
        }
        
        return j == n2 ? ans : std::vector<int>();
    }
};

