3302. Find the Lexicographically Smallest Valid Sequence

class Solution {
public:
    vector<int> validSequence(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();

        // exact[i] = position of word2[i] in an exact
        // subsequence match of word2[i...].
        vector<int> exact(m + 1, n);

        int p = n - 1;

        for (int i = m - 1; i >= 0; i--) {
            while (p >= 0 && word1[p] != word2[i])
                p--;

            if (p < 0)
                break;

            exact[i] = p;
            p--;
        }

        /*
            almost[i] = position of word2[i] in a subsequence
            match of word2[i...] with at most one mismatch.
        */
        vector<int> almost(m + 1, n);

        p = n - 1;
        int mismatch = 0;

        for (int i = m - 1; i >= 0; i--) {
            while (p >= 0) {
                if (word1[p] == word2[i]) {
                    almost[i] = p;
                    p--;
                    break;
                }

                if (mismatch == 0) {
                    // Use the one allowed mismatch here.
                    almost[i] = p;
                    p--;
                    mismatch = 1;
                    break;
                }

                p--;
            }
        }

        vector<int> ans;

        int pos = 0;
        bool used = false;

        for (int i = 0; i < m; i++) {

            while (pos < n) {

                bool match = (word1[pos] == word2[i]);

                // Can't use a second mismatch.
                if (!match && used) {
                    pos++;
                    continue;
                }

                bool canTake = false;

                if (i == m - 1) {
                    canTake = true;
                }
                else if (match) {
                    /*
                     * Current character matches.
                     * We can still use our mismatch later.
                     */
                    if (almost[i + 1] > pos)
                        canTake = true;
                }
                else {
                    /*
                     * Current character is our mismatch.
                     * Therefore the rest must match exactly.
                     */
                    if (exact[i + 1] > pos)
                        canTake = true;
                }

                if (canTake) {
                    ans.push_back(pos);

                    if (!match)
                        used = true;

                    pos++;
                    break;
                }

                pos++;
            }

            if ((int)ans.size() != i + 1)
                return {};
        }

        return ans;
    }
};
