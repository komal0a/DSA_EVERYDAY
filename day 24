1386. Cinema Seat Allocation
class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        
        unordered_map<int, int> mp;

        // Store reserved seats for each affected row
        for (auto &seat : reservedSeats) {
            int row = seat[0];
            int s = seat[1];

            mp[row] |= (1 << s);
        }

        // Every completely empty row can fit 2 groups
        int ans = 2 * n;

        // Recalculate the answer for rows having reservations
        for (auto &[row, mask] : mp) {
            
            // Start by removing the 2 groups we assumed
            ans -= 2;

            bool left = ((mask & 
                         ((1 << 2) | (1 << 3) | (1 << 4) | (1 << 5))) == 0);

            bool right = ((mask & 
                          ((1 << 6) | (1 << 7) | (1 << 8) | (1 << 9))) == 0);

            bool middle = ((mask & 
                           ((1 << 4) | (1 << 5) | (1 << 6) | (1 << 7))) == 0);

            if (left && right) {
                // Can fit two groups
                ans += 2;
            }
            else if (left || right || middle) {
                // Can fit one group
                ans += 1;
            }
        }

        return ans;
    }
};
