1927. Sum Game
class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int mid = n / 2;

        int leftSum = 0, rightSum = 0;
        int leftQ = 0, rightQ = 0;

        for (int i = 0; i < mid; i++) {
            if (num[i] == '?')
                leftQ++;
            else
                leftSum += num[i] - '0';
        }

        for (int i = mid; i < n; i++) {
            if (num[i] == '?')
                rightQ++;
            else
                rightSum += num[i] - '0';
        }

        // Only one '?' -> Alice can choose a digit.
        if (leftQ + rightQ == 1) {
            return abs(leftSum - rightSum) != 0 &&
                   abs(leftSum - rightSum) != 9;
        }

        int sumDiff = leftSum - rightSum;
        int qDiff = leftQ - rightQ;

        return sumDiff != -9 * qDiff / 2;
    }
};
